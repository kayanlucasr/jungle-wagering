NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jungle_wagering
DB_USER=wagering_app
DB_PASSWORD=runtime_dev_only
# Administration and migration credentials never belong to the application container.
ADMIN_DB_USER=jungle
ADMIN_DB_PASSWORD=jungle_dev_only
MIGRATION_DB_USER=wagering_migrator
MIGRATION_DB_PASSWORD=migration_dev_only
RUNTIME_DB_USER=wagering_app
RUNTIME_DB_PASSWORD=runtime_dev_only
DB_POOL_MAX=10
DEPENDENCY_TIMEOUT_MS=2000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_EVENTS_DLQ_NAME=wager-events-dlq.fifo
SQS_WAIT_SECONDS=20
CONSUMER_CONCURRENCY=4
MESSAGING_RETRY_BASE_SECONDS=1
MESSAGING_RETRY_CAP_SECONDS=300
WORKER_SHUTDOWN_TIMEOUT_MS=10000
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_POLL_MS=1000
PENDING_REFERENCE_TTL_SECONDS=86400
PENDING_REFERENCE_MAX_ATTEMPTS=20
PENDING_REFERENCE_BASE_SECONDS=1
PENDING_REFERENCE_CAP_SECONDS=300
PENDING_REFERENCE_POLL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_IDLE_TIMEOUT_MS=10000

POSTGRES_HOST_PORT=5432
LOCALSTACK_HOST_PORT=4566
# APP_HOST_PORT vazio permite porta efêmera por réplica.
APP_HOST_PORT=
